{
  "name": "seiyaku-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm --workspace=@seiyaku/circuit-tools run typecheck && npm --workspace=@seiyaku/agent-sdk run typecheck && npm --workspace=@seiyaku/web run typecheck",
    "test": "node scripts/test-all.mjs",
    "test:unit": "vitest run",
    "build": "node scripts/build-all.mjs",
    "build:web": "npm --workspace=@seiyaku/web run build",
    "abi:generate": "tsx scripts/generate-abi.ts",
    "abi:check": "tsx scripts/check-abi.ts",
    "web:smoke": "tsx scripts/web-chain-smoke.ts",
    "agent:smoke": "tsx scripts/agent-smoke.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "check:static": "node scripts/check-static.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "vitest run apps/web/src/shared/i18n/i18n.test.ts",
    "fork": "node scripts/fork.mjs",
    "fork:check": "node scripts/fork-check.mjs",
    "print:mandate": "tsx scripts/print-mandate-v1.ts",
    "tapeout:fork": "tsx scripts/tapeout-fork.ts",
    "fork:deploy": "tsx scripts/deploy-fork.ts",
    "fork:flow": "tsx scripts/flow-fork.ts",
    "fork:reset-generated": "git checkout -- contracts/test/fork/Generated.sol",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts",
    "verify:sourcify": "tsx scripts/verify-sourcify.ts",
    "deweb:publish": "tsx scripts/deweb-publish.ts",
    "vectors": "tsx scripts/generate-vectors.ts",
    "vectors:check": "tsx scripts/check-vectors.ts",
    "e2e": "tsx scripts/run-e2e.ts",
    "demo:prepare": "tsx scripts/demo-prepare.ts",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.48.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.17.0",
    "axe-core": "4.10.2",
    "eslint": "9.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.3.3",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.3"
  }
}
